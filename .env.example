# Core runtime
DATABASE_URL=postgresql://secplatform:secplatform-local@localhost:5432/secplatform
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_URL=http://localhost:3000
LOG_LEVEL=info

# Development-only login display
NEXT_PUBLIC_SHOW_DEV_CREDENTIALS=false

# External AI is disabled unless both values are configured.
AI_EXTERNAL_PROCESSING_ENABLED=false
ANTHROPIC_API_KEY=

# Jira Cloud integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_ASSESSMENT=
JIRA_PROJECT_VULNERABILITY=
JIRA_ASSESSMENT_JQL=
JIRA_VULNERABILITY_JQL=
JIRA_SYNC_INTERVAL=15
JIRA_WEBHOOK_SECRET=

# Email delivery is currently a logging stub; these are reserved for an SMTP implementation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=secplatform@company.com

# Optional production seed passwords. Never use the development defaults in production.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_ENGINEER_PASSWORD=

# Docker Compose overrides
DOCKER_AUTH_SECRET=local-only-change-before-production
APP_PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=secplatform-local
REDIS_PORT=6379
